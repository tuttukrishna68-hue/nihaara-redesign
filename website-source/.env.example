# Optional backend. Default front-end mode uses the existing EmailJS service.
# To use this API, also set enquiryMode: 'api' in js/config.js.
PORT=3000
HOST=0.0.0.0
# On persistent hosting, set DATA_DIR to an absolute writable durable directory.
# DATA_DIR=/absolute/path/to/private-nihaara-data
# Optional HTTPS endpoint for lead notification (e.g. your own CRM/workflow).
# A 2xx reply means the webhook accepted delivery; verify its downstream setup.
# ENQUIRY_WEBHOOK_URL=https://your-owned-endpoint.example/enquiries
# ENQUIRY_WEBHOOK_TOKEN=replace-with-a-private-token
